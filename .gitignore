# =======================================================
# Monorepo RPA LAD-6819 — Git Ignore Rules
# =======================================================

# -------------------------------------------------------
# Frontend (Next.js & Node.js)
# -------------------------------------------------------
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
frontend/dist/
dist/
frontend/.vercel/
.vercel/
*.tsbuildinfo

# Frontend Environment Variables & Secrets
frontend/.env
frontend/.env*.local
.env
.env*.local

# -------------------------------------------------------
# Backend (Python & RPA Engine)
# -------------------------------------------------------
backend/venv/
backend/.venv/
venv/
.venv/
backend/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
backend/.pytest_cache/
.pytest_cache/
backend/logs/*.log
logs/*.log
*.log

# Backend Secrets & Configs
backend/.env
backend/firebase-key.json
firebase-key.json
backend/.azure/
.azure/
backend/files/temp/
backend/files/salidas/

# -------------------------------------------------------
# Operating System & Temporary Files
# -------------------------------------------------------
.DS_Store
Thumbs.db
~$*.docx
~$*.xlsx
