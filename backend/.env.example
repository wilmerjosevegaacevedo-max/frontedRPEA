# =============================================
# CONFIGURACIÓN FTP
# =============================================
FTP_HOST=ftp.tuservidor.com
FTP_USER=usuario_ftp
FTP_PASSWORD=password_ftp
FTP_PORT=21
FTP_REMOTE_PATH=/ruta/remota/

# =============================================
# CORREO SALIENTE (SMTP)
# =============================================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=bot-rpa@tuempresa.com
SMTP_PASSWORD=password_smtp
SMTP_USE_TLS=true

# =============================================
# BUZÓN ENTRANTE (Exchange/IMAP)
# =============================================
MAILBOX_HOST=outlook.office365.com
MAILBOX_USER=bot-rpa@tuempresa.com
MAILBOX_PASSWORD=password_mailbox
MAILBOX_FOLDER=INBOX
MAILBOX_PROCESSED_FOLDER=Procesados
MAILBOX_ERROR_FOLDER=Errores

# =============================================
# AWS S3 (opcional)
# =============================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# =============================================
