        </mxCell>

        <!-- 7. Motor RPA <-> Servicios Externos -->
        <mxCell id="edge-rpa-ext" value="&lt;b&gt;«IMAP:993 / SMTP:587 / FTP - acceso»&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#d8b4fe&quot;&gt;entra: correos con planillas Excel adjuntas&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#fde047&quot;&gt;sale: correo con ZIP procesado / subida FTP&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=open;endFill=0;startArrow=open;startFill=0;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#e2e8f0;fontSize=10;labelBackgroundColor=#111318;" edge="1" parent="1" source="node-rpa" target="node-ext">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- LEYENDA: SÍMBOLOS DEL DIAGRAMA -->
        <mxCell id="legend-dep" value="&lt;b&gt;SÍMBOLOS DEL DIAGRAMA (NOTACIÓN UML 2.5)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;[Cubo 3D]&lt;/b&gt; = Nodo de despliegue (&lt;i&gt;«device»&lt;/i&gt;, &lt;i&gt;«server»&lt;/i&gt;, &lt;i&gt;«cloud service»&lt;/i&gt;, &lt;i&gt;«storage»&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;[Rectángulo con 2 pestañas laterales]&lt;/b&gt; = Componente o artefacto desplegado dentro del nodo (&lt;i&gt;«componente»&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;[Rectángulo punteado]&lt;/b&gt; = Entorno de ejecución (&lt;i&gt;«execution environment»&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;Línea + flecha abierta&lt;/b&gt; = Ruta de comunicación (&lt;i&gt;communication path&lt;/i&gt;) y flujo de datos (&lt;i&gt;entra / sale&lt;/i&gt;)&lt;br&gt;• &lt;b&gt;«usa» / «acceso»&lt;/b&gt; = Naturaleza de la dependencia entre nodos y componentes&lt;br&gt;• &lt;b&gt;Protocolo indicado sobre cada ruta:&lt;/b&gt; HTTPS/REST, WSS (onSnapshot), IMAP/SMTP, FTP, I/O Local" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=18;fillColor=#18181b;strokeColor=#52525b;fontColor=#e4e4e7;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="900" width="660" height="165" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

