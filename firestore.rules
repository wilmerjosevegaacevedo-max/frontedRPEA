rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Función auxiliar de autenticación
    function estaAutenticado() {
      return request.auth != null;
    }

    // 1. Colección de Empresas y Reglas Paramétricas
    match /empresas/{empresaId} {
      allow read: if true;
      allow write: if estaAutenticado();
    }

    // 2. Colección de Lotes de Nómina (Jobs)
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update: if estaAutenticado();
      allow delete: if false;
    }

    // 3. Colección de Pagos Individuales (Unificada)
    match /pagos_individuales/{pagoId} {
      allow read: if true;
      allow create, update: if estaAutenticado();
      allow delete: if false;
    }

    match /pagos/{pagoId} {
      allow read: if true;
      allow create, update: if estaAutenticado();
      allow delete: if false;
    }

    // 4. Configuración RBAC y Matriz de Roles
    match /config/{docId} {
      allow read: if true;
      allow write: if estaAutenticado();
    }

    // 5. Colección de Auditoría y Bitácora RPA
    match /ejecuciones_rpa/{ejecucionId} {
      allow read: if true;
      allow create, update: if estaAutenticado();
      allow delete: if false;
    }

    // 6. Diagnóstico del Sistema y Healthcheck
    match /sistema_diagnostico/{docId} {
      allow read: if true;
      allow write: if estaAutenticado();
    }
  }
}
